<?xml version="1.0"?>
<ruleset name="Agentic Commerce &amp; AI Product Feed">
        <description>Official WordPress coding standard for the Agentic Commerce &amp; AI Product Feed plugin.</description>

        <!--
             Run with any PHPCS install that can see the WordPress standard:
             phpcs --standard=phpcs.xml
             (or simply `vendor/bin/phpcs` when the ruleset is auto-discovered).
             The text domain below also fixes WordPress.WP.I18n.TextDomainMismatch
             false positives that appear when phpcs is run from a renamed folder.
             NOTE: this developer file is export-ignored and never ships in
             distribution packages (Plugin Check flags *.dist files).
        -->

        <rule ref="WordPress">
                <!--
                     The feed engine streams potentially multi-megabyte catalog files
                     (JSONL / CSV / llms-full.txt) to disk page by page. WP_Filesystem
                     exposes no append or streaming API, and buffering arbitrarily
                     large catalogs in memory can exceed PHP memory_limit, so the two
                     streaming writers keep fopen/fwrite/fclose with per-line waivers
                     stating that justification. Every other file operation (mkdir,
                     move, delete, small writes) goes through WP_Filesystem.
                -->
        </rule>

        <config name="text_domain" value="agentic-commerce-ai-product-feed"/>
        <config name="minimum_supported_wp_version" value="6.2"/>

        <arg name="extensions" value="php"/>
        <arg name="colors"/>
        <arg value="sp"/>

        <file>.</file>

        <exclude-pattern>*/vendor/*</exclude-pattern>
        <exclude-pattern>*/node_modules/*</exclude-pattern>
        <exclude-pattern>*/languages/*</exclude-pattern>
</ruleset>
